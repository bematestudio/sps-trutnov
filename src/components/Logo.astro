---
interface Props {
	compact?: boolean;
	class?: string;
}
const { compact = false, class: className } = Astro.props;
---

<span class:list={["logo", className]}>
	<svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
		<circle cx="20" cy="20" r="19" fill="currentColor"></circle>
		<path
			d="M6 15h11l3-3h14M6 20h9l3 3h16M6 25h11l3 3h11"
			fill="none"
			stroke="var(--color-on-accent)"
			stroke-width="2.4"
			stroke-linecap="square"></path>
	</svg>
	{
		!compact && (
			<span class="logo__text">
				<span class="logo__name">SPŠ Trutnov</span>
				<span class="logo__sub">Střední průmyslová škola</span>
			</span>
		)
	}
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		color: var(--color-text);
		line-height: 1;
	}
	.logo__mark {
		inline-size: calc(var(--icon-l) * 1.3);
		block-size: calc(var(--icon-l) * 1.3);
		color: var(--color-accent);
		transition: rotate var(--duration-slow) var(--ease-emphasized);
	}
	a:hover > .logo .logo__mark,
	a:hover .logo__mark {
		rotate: -12deg;
	}
	.logo__text {
		display: grid;
		gap: var(--space-3xs);
	}
	.logo__name {
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-snug);
	}
	.logo__sub {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}
</style>
