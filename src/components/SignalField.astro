---
/**
 * Animated field of vertical "signal" dashes rendered to canvas.
 * Colours come from tokens (--color-hero-line / --color-hero-line-accent) and
 * re-read on theme change. Pauses off-screen; static under reduced motion.
 */
interface Props {
	variant?: "wave" | "bars";
	class?: string;
}
const { variant = "wave", class: className } = Astro.props;
---

<canvas class:list={["signal", className]} data-signal={variant} aria-hidden="true"></canvas>

<style>
	.signal {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		pointer-events: none;
		mask-image: radial-gradient(ellipse at 50% 45%, var(--prim-ink) 30%, transparent 78%);
	}
</style>

<script>
	function initSignals() {
		document.querySelectorAll<HTMLCanvasElement>("canvas[data-signal]").forEach((canvas) => {
			if (canvas.dataset.ready) return;
			canvas.dataset.ready = "true";
			const ctx = canvas.getContext("2d");
			if (!ctx) return;
			const variant = canvas.dataset.signal;
			const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
			let w = 0;
			let h = 0;
			let dpr = 1;
			let line = "";
			let accent = "";
			let running = false;
			let raf = 0;
			const readColors = () => {
				const cs = getComputedStyle(canvas);
				line = cs.getPropertyValue("--color-hero-line").trim() || "gray";
				accent = cs.getPropertyValue("--color-hero-line-accent").trim() || "blue";
			};
			const resize = () => {
				dpr = Math.min(2, window.devicePixelRatio || 1);
				w = canvas.clientWidth;
				h = canvas.clientHeight;
				canvas.width = Math.round(w * dpr);
				canvas.height = Math.round(h * dpr);
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			};
			// Deterministic pseudo-random so accents don't flicker.
			const rand = (i: number) => {
				const x = Math.sin(i * 127.1) * 43758.5453;
				return x - Math.floor(x);
			};
			const draw = (t: number) => {
				ctx.clearRect(0, 0, w, h);
				const gap = w < 640 ? 14 : 18;
				const cols = Math.ceil(w / gap) + 1;
				if (variant === "bars") {
					for (let c = 0; c < cols; c++) {
						const x = c * gap;
						const edge = Math.abs(c / cols - 0.5) * 2; // 0 centre → 1 edges
						const amp = Math.max(0, edge - 0.25);
						const len = h * amp * (0.45 + 0.55 * Math.abs(Math.sin(t * 0.0006 + c * 0.35)));
						ctx.fillStyle = rand(c) > 0.55 ? accent : line;
						ctx.globalAlpha = 0.35 + amp * 0.6;
						ctx.fillRect(x, h - len, 3, len);
					}
					ctx.globalAlpha = 1;
					return;
				}
				const rows = Math.ceil(h / 26);
				const cx = w / 2;
				const cy = h * 0.42;
				for (let c = 0; c < cols; c++) {
					for (let r = 0; r < rows; r++) {
						const x = c * gap;
						const y0 = r * 26;
						const d = Math.hypot(x - cx, (y0 - cy) * 1.6);
						const wave = Math.sin(d * 0.018 - t * 0.0016);
						const len = 6 + (wave + 1) * 7;
						const isAccent = rand(c * 31 + r) > 0.985;
						ctx.fillStyle = isAccent ? accent : line;
						ctx.globalAlpha = isAccent ? 0.9 : 0.25 + (wave + 1) * 0.3;
						ctx.fillRect(x, y0 + (26 - len) / 2 + wave * 3, isAccent ? 2 : 1.25, len);
					}
				}
				ctx.globalAlpha = 1;
			};
			const loop = (t: number) => {
				draw(t);
				if (running) raf = requestAnimationFrame(loop);
			};
			readColors();
			resize();
			draw(0);
			new ResizeObserver(() => {
				resize();
				draw(performance.now());
			}).observe(canvas);
			new MutationObserver(() => {
				readColors();
				draw(performance.now());
			}).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
			if (reduced) return;
			new IntersectionObserver(([entry]) => {
				running = entry.isIntersecting;
				cancelAnimationFrame(raf);
				if (running) raf = requestAnimationFrame(loop);
			}).observe(canvas);
		});
	}
	initSignals();
</script>
