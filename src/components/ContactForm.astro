---
import Icon from "./Icon.astro";
import { SCHOOL_EMAIL } from "../lib/site";
interface Props {
	title?: string;
	topic?: string;
}
const { title = "Napište nám", topic = "obecný dotaz" } = Astro.props;
const id = `cf-${Math.random().toString(36).slice(2, 7)}`;
---

<!--
	No server-side delivery yet (audit F05): the form validates the input and
	opens the visitor's e-mail program with a pre-filled message to the school.
	Swap to a POST endpoint once an e-mail service (e.g. Cloudflare Email
	Routing / Resend) is set up.
-->
<form class="contact-form panel panel--plus" action={`mailto:${SCHOOL_EMAIL}`} method="get" data-contact-form data-to={SCHOOL_EMAIL} novalidate>
	<div class="stack stack--s">
		<h2 class="h-card contact-form__title">{title}</h2>
		<p class="meta">Odešle se z vašeho e-mailu na <a class="link" href={`mailto:${SCHOOL_EMAIL}`}>{SCHOOL_EMAIL}</a></p>
	</div>
	<input type="hidden" name="topic" value={topic} data-topic />
	<div class="contact-form__row">
		<div class="field">
			<label class="field__label" for={`${id}-name`}>Jméno a příjmení</label>
			<input class="input" id={`${id}-name`} name="name" autocomplete="name" required minlength="3" />
		</div>
		<div class="field">
			<label class="field__label" for={`${id}-email`}>E-mail</label>
			<input class="input" id={`${id}-email`} name="email" type="email" autocomplete="email" required />
		</div>
	</div>
	<div class="field">
		<label class="field__label" for={`${id}-message`}>Zpráva</label>
		<textarea class="textarea" id={`${id}-message`} name="message" required minlength="10"></textarea>
	</div>
	<label class="checkbox">
		<input type="checkbox" name="consent" required />
		<span>Souhlasím se zpracováním osobních údajů podle <a class="link" href="/ochrana-osobnich-udaju">zásad ochrany osobních údajů</a>.</span>
	</label>
	<p class="contact-form__error" data-error role="alert" hidden></p>
	<button class="btn" type="submit">
		<span data-label>Připravit e-mail</span>
		<Icon name="arrow" size="s" class="btn__icon btn__icon--arrow" />
	</button>
</form>

<style>
	.contact-form {
		display: grid;
		gap: var(--space-m);
		padding: var(--space-xl) var(--space-l);
	}
	.contact-form__title {
		font-size: var(--text-xl);
	}
	.contact-form__row {
		display: grid;
		gap: var(--space-m);
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
	}
	.contact-form .btn {
		justify-self: start;
	}
	.contact-form__error {
		color: var(--color-danger);
	}
	.contact-form[data-state="sending"] .btn {
		opacity: 0.6;
		pointer-events: none;
	}
	.contact-form[data-state="sent"] {
		border-color: var(--color-success);
	}
</style>

<script>
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		if (form.dataset.ready) return;
		form.dataset.ready = "true";
		const error = form.querySelector<HTMLElement>("[data-error]")!;
		const label = form.querySelector<HTMLElement>("[data-label]")!;
		form.addEventListener("submit", (e) => {
			e.preventDefault();
			error.hidden = true;
			if (!form.checkValidity()) {
				const first = form.querySelector<HTMLElement>(":invalid");
				error.textContent = "Vyplňte prosím všechna povinná pole a potvrďte souhlas.";
				error.hidden = false;
				first?.focus();
				return;
			}
			const data = new FormData(form);
			const topic = String(data.get("topic") ?? "dotaz");
			const subject = `Web SPŠ Trutnov — ${topic}`;
			const body = `${String(data.get("message") ?? "").trim()}\n\n—\n${String(data.get("name") ?? "").trim()}\n${String(data.get("email") ?? "").trim()}`;
			const href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			form.dataset.state = "sent";
			label.textContent = "Otevírám e-mail…";
			window.location.href = href;
			window.setTimeout(() => {
				label.textContent = "Připravit e-mail";
				window.spsToast?.("Zpráva je připravená ve vašem e-mailovém programu — stačí ji odeslat.");
			}, 600);
		});
	});
</script>
