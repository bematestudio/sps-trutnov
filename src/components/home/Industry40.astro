---
/**
 * Interactive "Průmysl 4.0" section: an animated network diagram (pure SVG +
 * CSS dash animation) with a tab list. Selecting a technology highlights its
 * node/link and swaps the detail panel. Auto-advances while visible until the
 * visitor interacts; static under reduced motion. ~1 kB of JS.
 */
import images from "../../data/images.json";
import Icon from "../Icon.astro";
import Photo from "../Photo.astro";

const techs = [
	{
		id: "robotika",
		label: "Robotika",
		title: "Průmyslové roboty FANUC",
		text: "Žáci programují a oživují robotická pracoviště — od simulace cyklu po skutečné rameno na lince.",
		img: "roboticke-pracoviste",
		obory: ["STR", "SLE"],
	},
	{
		id: "plc",
		label: "PLC a automatizace",
		title: "Automatizace s PLC a pneumatikou",
		text: "Programovatelné automaty, senzory, elektropneumatika a vizualizace procesů v laboratoři automatizace.",
		img: "pneumatika-plc",
		obory: ["SLE", "EL"],
	},
	{
		id: "cnc",
		label: "CNC obrábění",
		title: "CNC soustruhy a frézky",
		text: "Od výkresu přes program v EdgeCAM až po hotový díl — přesné obrábění kovů na moderních strojích.",
		img: "frezovani-nas",
		obory: ["NA", "STR"],
	},
	{
		id: "iot",
		label: "IoT a elektronika",
		title: "Vestavěné systémy a internet věcí",
		text: "Mikrokontroléry, sběr dat ze senzorů, návrh plošných spojů a zařízení připojená do sítě.",
		img: "slaboprouda-elektrotechnika1",
		obory: ["EPS", "SLE"],
	},
	{
		id: "cad",
		label: "3D modelování a tisk",
		title: "CAD, 3D tisk a digitální dvojčata",
		text: "Autodesk Inventor, AutoCAD a 3ds Max. Z modelu rovnou na 3D tiskárnu, kterou si žáci sami postavili.",
		img: "stavba-3d-tiskarny",
		obory: ["STR", "IM"],
	},
	{
		id: "site",
		label: "Sítě a kyberbezpečnost",
		title: "Sítě, cloud a kybernetická bezpečnost",
		text: "Cisco a Mikrotik akademie, správa serverů, Wi-Fi infrastruktura a soutěže v kyberbezpečnosti.",
		img: "router-site",
		obory: ["EPS", "IM"],
	},
] as const satisfies ReadonlyArray<{ img: keyof typeof images } & Record<string, unknown>>;

// Node positions on a 600×600 canvas around the central hub.
const R = 220;
const nodes = techs.map((t, i) => {
	const a = (i / techs.length) * Math.PI * 2 - Math.PI / 2;
	return { ...t, x: 300 + Math.cos(a) * R, y: 300 + Math.sin(a) * R };
});
---

<section class="i40" id="prumysl-4-0" data-i40 data-active="robotika" aria-labelledby="i40-title">
	<div class="container i40__grid">
		<div class="i40__intro">
			<span class="eyebrow">Průmysl 4.0</span>
			<h2 class="h-section" id="i40-title">Učíme technologie, které teprve přicházejí do&nbsp;firem.</h2>
			<p class="lead">Robotika, automatizace, digitální výroba a kyberbezpečnost — v laboratořích, které odpovídají moderním továrnám regionu.</p>
			<div class="i40__tabs" role="tablist" aria-label="Technologie Průmyslu 4.0">
				{
					techs.map((t, i) => (
						<button class="i40__tab" type="button" role="tab" id={`i40-tab-${t.id}`} aria-controls="i40-panel" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-tech={t.id}>
							<span class="i40__tab-index">{String(i + 1).padStart(2, "0")}</span>
							{t.label}
						</button>
					))
				}
			</div>
		</div>

		<div class="i40__stage">
			<svg class="i40__diagram" viewBox="0 0 600 600" aria-hidden="true">
				<circle class="i40__orbit" cx="300" cy="300" r={R}></circle>
				<circle class="i40__orbit i40__orbit--inner" cx="300" cy="300" r="120"></circle>
				{nodes.map((n) => <line class="i40__link" data-node={n.id} x1="300" y1="300" x2={n.x} y2={n.y} />)}
				<g class="i40__hub">
					<circle cx="300" cy="300" r="62"></circle>
					<text x="300" y="294" text-anchor="middle" font-size="15">Digitální</text>
					<text x="300" y="316" text-anchor="middle" font-size="15">továrna</text>
				</g>
				{
					nodes.map((n, i) => (
						<g class="i40__node" data-node={n.id} style={`--i:${i}`}>
							<circle cx={n.x} cy={n.y} r="34" />
							<text x={n.x} y={n.y + 5} text-anchor="middle" font-size="14">
								{String(i + 1).padStart(2, "0")}
							</text>
						</g>
					))
				}
			</svg>

			<div class="i40__panel" id="i40-panel" role="tabpanel" aria-live="polite">
				{
					techs.map((t, i) => (
						<article class="i40__card" data-card={t.id} hidden={i !== 0}>
							<figure class="i40__photo">
								<Photo name={t.img} alt="" sizes="(width >= 75rem) 14rem, 40vw" />
							</figure>
							<div class="i40__card-body">
								<h3 class="h-card">{t.title}</h3>
								<p class="muted">{t.text}</p>
								<div class="cluster">
									{t.obory.map((o) => <span class="tag">{o}</span>)}
								</div>
							</div>
						</article>
					))
				}
				<a class="link-arrow i40__more" href="/studium/proc-studovat-u-nas">Vybavení školy <Icon name="arrow" size="s" /></a>
			</div>
		</div>
	</div>
</section>

<style>
	.i40 {
		position: relative;
		overflow: hidden;
		padding-block: var(--section-space);
		background: var(--prim-ink);
		color: var(--prim-paper);
		--color-text: var(--prim-paper);
		--color-text-muted: var(--prim-slate-light);
		--color-border: var(--prim-ink-line);
		--color-bg: var(--prim-ink);
		--color-elevated: var(--prim-ink-2);
		--color-accent-text: var(--prim-blue-300);
		--color-focus: var(--prim-blue-300);
	}
	.i40__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-xl);
		align-items: center;
	}
	.i40__intro {
		display: grid;
		gap: var(--space-m);
		justify-items: start;
	}
	.i40__tabs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
	}
	.i40__tab {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		min-block-size: var(--tap-target);
		padding-inline: var(--space-s);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-muted);
		transition:
			background-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out);
	}
	.i40__tab:hover {
		color: var(--color-text);
		border-color: var(--color-text-muted);
	}
	.i40__tab[aria-selected="true"] {
		background: var(--prim-blue-500);
		border-color: var(--prim-blue-500);
		color: var(--prim-white);
	}
	.i40__tab-index {
		font-variant-numeric: tabular-nums;
		font-size: var(--text-xs);
	}
	.i40__stage {
		position: relative;
		display: grid;
		gap: var(--space-m);
	}

	/* Diagram */
	.i40__diagram {
		inline-size: 100%;
		max-inline-size: 34rem;
		margin-inline: auto;
		overflow: visible;
		font-variant-numeric: tabular-nums;
	}
	.i40__orbit {
		fill: none;
		stroke: var(--prim-ink-line);
		stroke-dasharray: 2 8;
	}
	.i40__orbit--inner {
		animation: i40-spin calc(var(--duration-slower) * 40) linear infinite;
		transform-box: fill-box;
		transform-origin: center;
	}
	.i40__link {
		stroke: var(--prim-ink-line);
		stroke-width: 1.5;
		stroke-dasharray: 6 10;
		animation: i40-flow calc(var(--duration-slower) * 2) linear infinite;
		transition: stroke var(--duration-base) var(--ease-out);
	}
	.i40__hub circle {
		fill: var(--prim-blue-500);
	}
	.i40__hub text {
		fill: var(--prim-white);
		font-family: var(--font-sans);
		font-weight: var(--weight-medium);
	}
	.i40__node {
		cursor: pointer;
	}
	.i40__node circle {
		fill: var(--prim-ink-2);
		stroke: var(--prim-ink-line);
		stroke-width: 1.5;
		transform-box: fill-box;
		transform-origin: center;
		transition:
			fill var(--duration-base) var(--ease-out),
			stroke var(--duration-base) var(--ease-out),
			scale var(--duration-base) var(--ease-emphasized);
	}
	.i40__node text {
		fill: var(--prim-slate-light);
		transition: fill var(--duration-base) var(--ease-out);
	}
	.i40__node:hover circle {
		stroke: var(--prim-blue-300);
	}
	/* Active state driven by [data-active] on the section */
	.i40[data-active="robotika"] [data-node="robotika"],
	.i40[data-active="plc"] [data-node="plc"],
	.i40[data-active="cnc"] [data-node="cnc"],
	.i40[data-active="iot"] [data-node="iot"],
	.i40[data-active="cad"] [data-node="cad"],
	.i40[data-active="site"] [data-node="site"] {
		--on: 1;
	}
	.i40__link {
		stroke: color-mix(in oklab, var(--prim-blue-300) calc(var(--on, 0) * 100%), var(--prim-ink-line));
		animation-duration: calc(var(--duration-slower) * (2 - var(--on, 0) * 1.4));
	}
	.i40__node circle {
		fill: color-mix(in oklab, var(--prim-blue-500) calc(var(--on, 0) * 100%), var(--prim-ink-2));
		stroke: color-mix(in oklab, var(--prim-blue-300) calc(var(--on, 0) * 100%), var(--prim-ink-line));
		scale: calc(1 + var(--on, 0) * 0.24);
	}
	.i40__node text {
		fill: color-mix(in oklab, var(--prim-white) calc(var(--on, 0) * 100%), var(--prim-slate-light));
	}
	@keyframes i40-flow {
		to {
			stroke-dashoffset: -32;
		}
	}
	@keyframes i40-spin {
		to {
			rotate: 360deg;
		}
	}

	/* Detail card */
	.i40__panel {
		display: grid;
		gap: var(--space-s);
	}
	.i40__card {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		gap: var(--space-m);
		align-items: center;
		padding: var(--space-2xs);
		background: var(--prim-ink-2);
		border: var(--border-width) solid var(--prim-ink-line);
		border-radius: var(--radius-l);
		animation: i40-card var(--duration-slow) var(--ease-emphasized);
	}
	.i40__card[hidden] {
		display: none;
	}
	@keyframes i40-card {
		from {
			opacity: 0;
			translate: 0 var(--space-s);
		}
	}
	.i40__photo {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-m);
		aspect-ratio: 1;
	}
	.i40__photo :global(img) {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}
	.i40__card-body {
		display: grid;
		gap: var(--space-xs);
		padding-inline-end: var(--space-s);
	}
	.i40__more {
		justify-self: end;
	}
	@media (width >= 75rem) {
		.i40__grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.i40__link,
		.i40__orbit--inner {
			animation: none;
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>("[data-i40]");
	if (root) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
		const cards = [...root.querySelectorAll<HTMLElement>("[data-card]")];
		let auto = !matchMedia("(prefers-reduced-motion: reduce)").matches;
		let timer = 0;
		let visible = false;
		const select = (id: string, focus = false) => {
			root.dataset.active = id;
			tabs.forEach((t) => {
				const on = t.dataset.tech === id;
				t.setAttribute("aria-selected", String(on));
				t.tabIndex = on ? 0 : -1;
				if (on && focus) t.focus();
			});
			cards.forEach((c) => (c.hidden = c.dataset.card !== id));
			root.querySelector("[role=tabpanel]")?.setAttribute("aria-labelledby", `i40-tab-${id}`);
		};
		const stop = () => ((auto = false), window.clearTimeout(timer));
		const cycle = () => {
			window.clearTimeout(timer);
			if (!auto || !visible) return;
			timer = window.setTimeout(() => {
				const i = tabs.findIndex((t) => t.dataset.tech === root.dataset.active);
				select(tabs[(i + 1) % tabs.length].dataset.tech!);
				cycle();
			}, 4200);
		};
		tabs.forEach((t, i) => {
			t.addEventListener("click", () => (stop(), select(t.dataset.tech!)));
			t.addEventListener("keydown", (e) => {
				const d = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
				if (!d) return;
				e.preventDefault();
				stop();
				select(tabs[(i + d + tabs.length) % tabs.length].dataset.tech!, true);
			});
		});
		root.querySelectorAll<SVGGElement>(".i40__node").forEach((n) =>
			n.addEventListener("click", () => (stop(), select(n.dataset.node!))),
		);
		new IntersectionObserver(([e]) => ((visible = e.isIntersecting), cycle()), { threshold: 0.35 }).observe(root);
	}
</script>
