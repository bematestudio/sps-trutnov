---
import type images from "../data/images.json";
import Breadcrumbs from "./Breadcrumbs.astro";
import Photo from "./Photo.astro";

interface Props {
	title: string;
	lead?: string;
	crumbs?: Array<{ label: string; href?: string }>;
	image?: keyof typeof images;
}
const { title, lead, crumbs = [], image } = Astro.props;
---

<section class:list={["page-hero", image && "page-hero--media"]}>
	<div class="container page-hero__inner">
		<div class="page-hero__text">
			{crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
			<h1 class="page-hero__title" data-split>{title}</h1>
			{lead && <p class="lead" data-reveal>{lead}</p>}
			<slot />
		</div>
		{
			image && (
				<figure class="page-hero__media" data-reveal>
					<Photo name={image} eager sizes="(width >= 75rem) 40vw, 100vw" />
				</figure>
			)
		}
	</div>
	<hr class="divider" />
</section>

<style>
	.page-hero {
		padding-top: var(--section-space-sm);
		background: var(--color-surface);
	}
	.page-hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-xl);
		align-items: center;
		padding-bottom: var(--section-space-sm);
	}
	.page-hero__text {
		display: grid;
		gap: var(--space-m);
		justify-items: start;
		max-width: 52rem;
	}
	.page-hero__title {
		font-size: var(--text-3xl);
	}
	.page-hero__media {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-l);
		aspect-ratio: 4 / 3;
		background: var(--color-surface-2);
		box-shadow: var(--shadow-l);
	}
	.page-hero__media :global(img) {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}
	@media (width >= 75rem) {
		.page-hero--media .page-hero__inner {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		}
	}
</style>
