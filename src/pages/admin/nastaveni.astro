---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createCms } from "../../lib/cms";
import { MIGRATIONS, pendingMigrations } from "../../lib/migrations";
const settings = await createCms(Astro.locals).settings();
const pending = new Set((await pendingMigrations().catch(() => MIGRATIONS)).map((m) => m.id));
---

<AdminLayout title="Nastavení" heading="Nastavení webu">
	<form class="a-cols" data-settings>
		<section class="a-card a-form">
			<h2 class="a-card__title">Základní údaje</h2>
			<label class="field"><span class="field__label">Název webu</span><input class="input" name="title" value={settings.title} /></label>
			<label class="field"><span class="field__label">Popis (meta description)</span><textarea class="textarea" name="tagline" rows="3">{settings.tagline}</textarea></label>
			<label class="field"><span class="field__label">Telefon sekretariátu</span><input class="input" name="phone" value="+420 499 813 071" /></label>
			<label class="field"><span class="field__label">E-mail</span><input class="input" name="email" type="email" value="skola@spstrutnov.cz" /></label>
		</section>
		<section class="a-card a-form">
			<h2 class="a-card__title">Zobrazení</h2>
			<label class="a-switch"><span>Oznamovací lišta (den otevřených dveří)</span><input type="checkbox" name="announce" checked /></label>
			<label class="a-switch"><span>Úvodní animace při první návštěvě</span><input type="checkbox" name="loader" checked /></label>
			<label class="a-switch"><span>Výchozí tmavý režim</span><input type="checkbox" name="dark" /></label>
			<button class="btn" type="submit">Uložit nastavení</button>
		</section>
	</form>
	<section class="a-card a-form" aria-labelledby="maint-title">
		<h2 class="a-card__title" id="maint-title">Údržba CMS</h2>
		<p class="muted">
			Migrace doplňují do živého EmDash CMS nové části schématu a obsahu. Spouštějí se automaticky po nasazení; tlačítkem je
			lze spustit hned. Bezpečné spustit opakovaně. Vyžaduje roli administrátor v <a class="link" href="/_emdash/admin">EmDash CMS</a>.
		</p>
		<ul class="migrations" role="list" data-migrations>
			{MIGRATIONS.map((m) => (
				<li>
					<span class="tag">{pending.has(m.id) ? "čeká" : "hotovo"}</span>
					<span>{m.label}</span>
				</li>
			))}
		</ul>
		<div class="cluster">
			<button class="btn" type="button" data-migrate>Spustit migraci CMS</button>
			<output class="muted" data-migrate-out></output>
		</div>
	</section>
</AdminLayout>

<script>
	const migrate = document.querySelector<HTMLButtonElement>("[data-migrate]");
	const out = document.querySelector<HTMLOutputElement>("[data-migrate-out]");
	migrate?.addEventListener("click", async () => {
		migrate.disabled = true;
		out!.textContent = "Probíhá…";
		try {
			const res = await fetch("/api/maintenance/migrate", { method: "POST", credentials: "same-origin" });
			const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; ran?: Array<{ id: string; error?: string }>; pending?: number };
			if (data.ok) {
				out!.textContent = data.ran?.length ? `Hotovo — provedeno migrací: ${data.ran.length}. Obnovuji…` : "Vše je aktuální.";
				if (data.ran?.length) window.setTimeout(() => location.reload(), 900);
			} else {
				out!.textContent = data.error ?? data.ran?.find((r) => r.error)?.error ?? `Chyba ${res.status}`;
			}
		} catch {
			out!.textContent = "Migrace se nezdařila.";
		} finally {
			migrate.disabled = false;
		}
	});
	const form = document.querySelector<HTMLFormElement>("[data-settings]");
	form?.addEventListener("submit", (e) => {
		e.preventDefault();
		try {
			localStorage.setItem("sps-settings", JSON.stringify(Object.fromEntries(new FormData(form))));
		} catch {}
		window.spsToast?.("Nastavení uloženo v prohlížeči (ukázkový režim).");
	});
</script>

<style>
	.migrations {
		display: grid;
		gap: var(--space-xs);
	}
	.migrations li {
		display: flex;
		gap: var(--space-s);
		align-items: baseline;
	}
</style>
