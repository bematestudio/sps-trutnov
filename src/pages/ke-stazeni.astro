---
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";
import { createCms } from "../lib/cms";
import { docCategoryLabel } from "../lib/format";

const docs = await createCms(Astro.locals).documents();
const active = Astro.url.searchParams.get("kategorie") ?? "vse";
const cats = ["vse", ...new Set(docs.map((d) => d.category))];
---

<Base title="Ke stažení" description="Školní vzdělávací programy, přihlášky, formuláře, výroční zprávy a další dokumenty SPŠ Trutnov ke stažení.">
	<PageHero eyebrow="Ke stažení" title="Dokumenty a formuláře." lead="Školní vzdělávací programy, dokumenty k přijímacímu řízení, formuláře pro žáky a zákonné zástupce a povinné dokumenty školy." crumbs={[{ label: "Ke stažení" }]} />
	<section class="section section--sm" data-docs>
		<div class="container stack stack--l">
			<div class="cluster" role="group" aria-label="Kategorie dokumentů">
				{
					cats.map((c) => (
						<button class="tag" type="button" data-cat={c} aria-pressed={c === active ? "true" : "false"}>
							{c === "vse" ? "Vše" : (docCategoryLabel[c] ?? c)}
						</button>
					))
				}
			</div>
			<ul class="docs" role="list">
				{
					docs.map((d) => (
						<li class="doc" data-doc data-category={d.category} hidden={active !== "vse" && d.category !== active}>
							<span class="doc__type">{d.fileType}</span>
							<div class="doc__body">
								<a class="doc__title stretched" href={d.url} target="_blank" rel="noopener">{d.title}</a>
								<span class="meta">
									{docCategoryLabel[d.category] ?? d.category}
									{d.year && ` · ${d.year}`}
									{d.size && ` · ${d.size}`}
								</span>
							</div>
							<span class="doc__icon" aria-hidden="true"><Icon name="download" /></span>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Base>

<style>
	.docs {
		display: grid;
		gap: 0;
		padding: 0;
		border-top: var(--border-width) solid var(--color-border);
	}
	.doc {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-m);
		padding: var(--space-m) var(--space-2xs);
		border-bottom: var(--border-width) solid var(--color-border);
		transition: background-color var(--duration-fast) var(--ease-out);
	}
	.doc[hidden] {
		display: none;
	}
	.doc:hover {
		background: var(--color-surface);
	}
	.doc:has(:focus-visible) {
		box-shadow: var(--focus-ring);
	}
	.doc__title:focus-visible {
		box-shadow: none;
	}
	.doc__type {
		display: grid;
		place-items: center;
		inline-size: calc(var(--tap-target) * 1.2);
		block-size: calc(var(--tap-target) * 1.2);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-s);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-accent-text);
		background: var(--color-bg);
	}
	.doc__body {
		display: grid;
		gap: var(--space-3xs);
	}
	.doc__title {
		font-weight: var(--weight-medium);
		text-decoration: none;
	}
	.doc__icon {
		display: grid;
		place-items: center;
		inline-size: var(--tap-target);
		block-size: var(--tap-target);
		border-radius: var(--radius-s);
		transition:
			background-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out),
			translate var(--duration-base) var(--ease-emphasized);
	}
	.doc:hover .doc__icon {
		background: var(--color-accent);
		color: var(--color-on-accent);
		translate: 0 var(--space-3xs);
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>("[data-docs]");
	if (root) {
		const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-cat]")];
		const docs = [...root.querySelectorAll<HTMLElement>("[data-doc]")];
		buttons.forEach((b) =>
			b.addEventListener("click", () => {
				const cat = b.dataset.cat!;
				buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
				docs.forEach((d) => (d.hidden = cat !== "vse" && d.dataset.category !== cat));
				const url = new URL(location.href);
				if (cat === "vse") url.searchParams.delete("kategorie");
				else url.searchParams.set("kategorie", cat);
				history.replaceState(null, "", url);
			}),
		);
	}
</script>
