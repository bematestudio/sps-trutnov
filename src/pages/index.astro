---
import Carousel from "../components/Carousel.astro";
import Industry40 from "../components/home/Industry40.astro";
import Videos from "../components/home/Videos.astro";
import Icon from "../components/Icon.astro";
import Photo from "../components/Photo.astro";
import PostCard from "../components/PostCard.astro";
import SignalField from "../components/SignalField.astro";
import Base from "../layouts/Base.astro";
import { createCms } from "../lib/cms";
import { eventKindLabel, formatDay, formatMonth, formatTime } from "../lib/format";

const formatDayMonth = (d: Date) => new Intl.DateTimeFormat("cs-CZ", { day: "numeric", month: "numeric", timeZone: "Europe/Prague" }).format(d).replace(/\s/g, "\u00a0");

const cms = createCms(Astro.locals);
const [{ items: posts }, programs, events, partners, videos] = await Promise.all([
	cms.posts({ limit: 9 }),
	cms.programs(),
	cms.events({ upcoming: true }),
	cms.partners(),
	cms.videos(),
]);
const maturita = programs.filter((p) => p.type === "maturita");
const vyucni = programs.filter((p) => p.type === "vyucni-list");
const nextDod = events.find((e) => e.kind === "dod");

const dodDate = nextDod ? formatDayMonth(nextDod.start) : null;
/** The original homepage slider of spstrutnov.cz (same four slides, same photos). */
const slides = [
	{
		kind: "photo",
		img: "spstrutnov-dod-2026",
		tag: "Den otevřených dveří",
		title: dodDate ? `${dodDate} — ukážeme vám všechna pracoviště školy.` : "Ukážeme vám všechna pracoviště školy.",
		href: "/studium/den-otevrenych-dveri",
		cta: "Termíny a program",
	},
	{
		kind: "adobe",
		tag: "Adobe ve výuce",
		title: "Posouváme výuku grafiky a multimédií na vyšší úroveň — v profesionálních nástrojích Adobe.",
		apps: [
			{ code: "Ps", name: "Photoshop", key: "ps" },
			{ code: "Ai", name: "Illustrator", key: "ai" },
			{ code: "Id", name: "InDesign", key: "id" },
			{ code: "Pr", name: "Premiere Pro", key: "pr" },
			{ code: "Ac", name: "Acrobat Pro", key: "ac" },
			{ code: "Br", name: "Bridge", key: "br" },
		],
		href: "/studium/obory-vzdelani/informatika-a-management",
		cta: "Informatika a management",
	},
	{
		kind: "photo",
		img: "roboticke-pracoviste-wide",
		tag: "Robotické pracoviště",
		title: "Průmyslové roboty FANUC programuješ přímo ve výuce.",
		href: "#prumysl-4-0",
		cta: "Průmysl 4.0 u nás",
	},
	{
		kind: "cutout",
		img: "studentka-klik",
		tag: "Stipendium",
		title: "Stipendium až 30 000 Kč ročně ve vybraných oborech.",
		href: "/studium/stipendium",
		cta: "Jak ho získat",
	},
] as const;

const stats = [
	{ value: 613, label: "žáků ve 25 třídách", tone: "accent" },
	{ value: 57, label: "kvalifikovaných pedagogů", tone: "ink" },
	{ value: 300, suffix: "+", label: "počítačů a notebooků v síti", tone: "surface" },
	{ value: 4, label: "pracoviště a 10 laboratoří", tone: "plain" },
];
const academies = [
	{ name: "Cisco Networking Academy", text: "Celosvětový vzdělávací systém v oblasti počítačových sítí.", logo: "/images/akademie/cisco-networking-academy.png", w: 300, h: 150 },
	{ name: "Mikrotik Academy", text: "Správa a budování malých a středních počítačových a Wi-Fi sítí.", logo: "/images/akademie/mikrotik-academy.png", w: 300, h: 150 },
	{ name: "Autodesk Academia", text: "Nadstandardní výuka AutoCAD, Inventor a 3ds Max.", logo: "/images/akademie/autodesk-academia.png", w: 300, h: 150 },
	{ name: "Adobe Creative Cloud", text: "Photoshop, Illustrator, Premiere Pro a InDesign ve výuce.", logo: "/images/foto/adb-small-480.webp", w: 480, h: 320 },
];
---

<Base exactTitle title="SPŠ Trutnov — Střední průmyslová škola: elektrotechnika, IT a strojírenství" description="Střední průmyslová škola Trutnov — maturitní a učební obory v elektrotechnice, IT a strojírenství. Druhá největší střední škola v Královéhradeckém kraji.">
	<!-- ===================================================== HERO -->
	<section class="hero" aria-labelledby="hero-title">
		<div class="container hero__inner">
			<div class="hero__head">
				<div class="stack stack--s">
					<span class="eyebrow">Střední průmyslová škola · Trutnov · od roku 1952</span>
					<h1 class="hero__title" id="hero-title">Technika, která tě posune dál.</h1>
				</div>
				<div class="stack stack--s hero__aside">
					<p class="lead hero__lead">Elektro. IT. Strojírenství. Čtyři maturitní a dva učební obory, špičkové laboratoře a praxe u firem, které tě zaměstnají.</p>
					<div class="cluster hero__ctas">
						<a class="btn" href="/studium/obory-vzdelani">Vybrat obor <Icon name="arrow" size="s" class="btn__icon btn__icon--arrow" /></a>
						<a class="btn btn--secondary" href="/studium/den-otevrenych-dveri">Den otevřených dveří</a>
					</div>
				</div>
			</div>
			<Carousel label="Aktuálně ze školy" slide="100%" variant="hero" autoplay>
				{
					slides.map((s, i) => (
						<li class="carousel__slide">
							<a class={`slide slide--${s.kind}`} href={s.href}>
								{s.kind === "photo" && <Photo name={s.img} eager={i === 0} sizes="(width >= 82rem) 82rem, 100vw" class="slide__img" />}
								{s.kind === "adobe" && "apps" in s && (
									<span class="slide__art slide__apps" aria-hidden="true">
										{s.apps.map((a, j) => (
											<span class={`app app--${a.key}`} style={`--i: ${j}`}>
												<span class="app__tile">{a.code}</span>
												<span class="app__name">{a.name}</span>
											</span>
										))}
									</span>
								)}
								{s.kind === "cutout" && (
									<span class="slide__art" aria-hidden="true">
										<Photo name={s.img} sizes="(width >= 48rem) 40vw, 80vw" alt="" class="slide__cutout" />
									</span>
								)}
								<span class="slide__body">
									<span class="eyebrow slide__tag">{s.tag}</span>
									<span class="slide__title">{s.title}</span>
									<span class="slide__cta">
										{s.cta} <Icon name="arrow" size="s" />
									</span>
								</span>
							</a>
						</li>
					))
				}
			</Carousel>
		</div>
	</section>

	<!-- ===================================================== STACK SPLIT -->
	<section class="section" id="stack">
		<div class="container">
			<div class="stack-split" data-reveal-group>
				<div class="panel panel--accent panel--plus stack-split__claim" data-reveal>
					<span class="eyebrow">Co u nás studuješ</span>
					<p class="stack-split__headline">Elektro. IT. Strojírenství.</p>
					<p class="stack-split__text">
						Tři technické světy, jedna škola. Obory propojujeme tak, aby mezi nimi šlo přestoupit — z učebního do
						maturitního i naopak.
					</p>
				</div>
				<div class="panel panel--plus stack-split__media" data-reveal>
					<div class="dots" aria-hidden="true"></div>
					<figure class="frame stack-split__photo">
						<Photo name="studentka-vyskok" sizes="(width >= 48rem) 40vw, 100vw" alt="Radostná studentka SPŠ Trutnov ve školním tričku" />
					</figure>
					<p class="meta stack-split__caption">Staň se hrdým žákem průmyslovky</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ===================================================== PROGRAMS -->
	<section class="section section--flush-top">
		<div class="container">
			<div class="section-head section-head--split">
				<div class="stack stack--s">
					<span class="eyebrow">Obory vzdělání</span>
					<h2 class="h-section" data-split>Vyber si cestu, která ti sedí.</h2>
				</div>
				<a class="link-arrow" href="/studium/obory-vzdelani">Všechny obory <Icon name="arrow" size="s" /></a>
			</div>
			<div class="paths" data-reveal-group>
				{
					[
						{ title: "Maturitní obory", note: "4 roky · přijímací zkouška", items: maturita, cta: "Prozkoumat maturitní obory" },
						{ title: "Učební obory", note: "3 roky · se stipendiem kraje", items: vyucni, cta: "Prozkoumat učební obory" },
					].map((group) => (
						<div class="path" data-reveal>
							<div class="path__head">
								<h3 class="h-section path__title">{group.title}</h3>
								<p class="meta">{group.note}</p>
							</div>
							<ul class="path__list" role="list">
								{group.items.map((p) => (
									<li>
										<a class="path__item" href={`/studium/obory-vzdelani/${p.slug}`} style={`--program: var(--color-program-${p.color})`}>
											<span class="path__marker" aria-hidden="true" />
											<span class="path__name">{p.title}</span>
											<span class="path__code meta">{p.code.split(" ")[0]}</span>
											<Icon name="arrow" size="s" class="path__arrow" />
										</a>
									</li>
								))}
							</ul>
							<a class="path__cta btn btn--block" href="/studium/obory-vzdelani">
								{group.cta}
								<Icon name="arrow" size="s" class="btn__icon btn__icon--arrow" />
							</a>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- ===================================================== STATS -->
	<section aria-labelledby="stats-title">
		<h2 id="stats-title" class="visually-hidden">Škola v číslech</h2>
		<div class="stats" data-reveal-group>
			{
				stats.map((s) => (
					<div class={`stat stat--${s.tone}`} data-reveal>
						<span class="stat__value" data-count={s.value} data-suffix={s.suffix ?? ""}>
							{s.value}
							{s.suffix}
						</span>
						<span class="stat__label">{s.label}</span>
					</div>
				))
			}
		</div>
	</section>

	<!-- ===================================================== INDUSTRY 4.0 -->
	<Industry40 />

	<!-- ===================================================== NEWS -->
	<section class="section">
		<div class="container">
			<div class="section-head section-head--split">
				<div class="stack stack--s">
					<span class="eyebrow">Novinky</span>
					<h2 class="h-section" data-split>Co se u nás děje.</h2>
				</div>
				<a class="btn btn--outline" href="/novinky">Všechny novinky <Icon name="arrow" size="s" class="btn__icon btn__icon--arrow" /></a>
			</div>
			<Carousel label="Nejnovější novinky" slide="min(85%, 23rem)">
				{
					posts.map((p, i) => (
						<li class="carousel__slide">
							<PostCard post={p} eager={i < 2} />
						</li>
					))
				}
			</Carousel>
		</div>
	</section>

	<!-- ===================================================== VIDEOS -->
	<Videos videos={videos} />

	<!-- ===================================================== EVENTS + DOD -->
	<section class="section section--surface">
		<div class="container split split--wide-end">
			<div class="panel panel--inverse panel--plus dod" data-reveal>
				<span class="eyebrow">Ukážeme vám to!</span>
				<h2 class="h-section">Den otevřených dveří</h2>
				{
					nextDod && (
						<p class="dod__date">
							<span>{formatDay(nextDod.start)}.</span> {formatMonth(nextDod.start)} · {formatTime(nextDod.start)}–{nextDod.end ? formatTime(nextDod.end) : ""}
						</p>
					)
				}
				<p class="muted">Otevřeme všechna pracoviště — dílny, laboratoře, robotická pracoviště i CNC. V Mladých Bukách čeká dárek zdarma.</p>
				<a class="btn btn--light" href="/studium/den-otevrenych-dveri">Naplánovat návštěvu <Icon name="arrow" size="s" class="btn__icon btn__icon--arrow" /></a>
			</div>
			<div class="stack">
				<div class="stack stack--s">
					<span class="eyebrow">Kalendář</span>
					<h2 class="h-section">Důležité termíny</h2>
				</div>
				<ol class="events" role="list" data-reveal-group>
					{
						events.slice(0, 5).map((e) => (
							<li class="event" data-reveal>
								<time class="event__date" datetime={e.start.toISOString()}>
									<span class="event__day">{formatDay(e.start)}</span>
									<span class="event__month">{formatMonth(e.start)}</span>
								</time>
								<div class="event__body">
									<span class="tag tag--dot">{eventKindLabel[e.kind]}</span>
									<h3 class="h-card">{e.title}</h3>
									<p class="muted">{e.location}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>

	<!-- ===================================================== ACADEMIES -->
	<section class="section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Certifikáty a programy</span>
				<h2 class="h-section" data-split>Nadstandardní výuka ICT.</h2>
				<p class="lead">Během studia můžeš získat celosvětově uznávané certifikáty a pracovat v profesionálním softwaru zdarma.</p>
			</div>
			<ul class="grid grid--s academies" role="list" data-reveal-group>
				{
					academies.map((a) => (
						<li class="panel panel--plus academy" data-reveal>
							<span class="academy__logo">
								<img src={a.logo} alt={a.name} width={a.w} height={a.h} loading="lazy" decoding="async" />
							</span>
							<h3 class="h-card">{a.name}</h3>
							<p class="muted">{a.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ===================================================== PARTNERS -->
	<section class="partners" aria-labelledby="partners-title">
		<div class="container partners__head">
			<div class="stack stack--s">
				<span class="eyebrow">Partneři</span>
				<h2 class="h-card" id="partners-title">Spolupracujeme s nejvýznamnějšími firmami regionu</h2>
			</div>
			<div class="cluster">
				<button class="btn btn--ghost" type="button" data-motion-toggle aria-pressed="false"><span data-motion-label>Pozastavit animace</span></button>
				<a class="link-arrow" href="/o-skole/partnerstvi-a-spoluprace">Partnerství a spolupráce <Icon name="arrow" size="s" /></a>
			</div>
		</div>
		<div class="marquee">
			{
				[0, 1].map((copy) => (
					<ul class="marquee__track" role="list" aria-hidden={copy === 1 ? "true" : undefined}>
						{partners.map((p) => (
							<li class="marquee__item">
								{/* Eager: lazy images inside the horizontally clipped track only load once they scroll in. */}
								{p.logo ? <img src={p.logo.src} alt={copy === 0 ? p.name : ""} width={p.logo.width ?? 270} height={p.logo.height ?? 90} loading="eager" fetchpriority="low" decoding="async" /> : <span>{p.name}</span>}
							</li>
						))}
					</ul>
				))
			}
		</div>
	</section>

	<!-- ===================================================== CTA -->
	<section class="cta">
		<SignalField variant="bars" class="cta__bars" />
		<div class="container cta__inner">
			<span class="eyebrow">Přihláška 2027</span>
			<h2 class="h-display" data-split>Staň se hrdým žákem průmyslovky.</h2>
			<p class="lead">Studium je zdarma — a ve vybraných oborech za něj dostaneš zaplaceno.</p>
			<div class="cluster">
				<a class="btn" href="/studium/prijimaci-rizeni">Přijímací řízení <Icon name="arrow" size="s" class="btn__icon btn__icon--arrow" /></a>
				<a class="btn btn--light" href="/studium/stipendium">Stipendium</a>
			</div>
		</div>
	</section>
</Base>

<style>
	/* ---------- Hero (original homepage slider) ------------------------- */
	.hero {
		padding-block: var(--space-l) var(--section-space-sm);
	}
	.hero__inner {
		display: grid;
		gap: var(--space-l);
	}
	.hero__head {
		display: grid;
		gap: var(--space-m);
		align-items: end;
	}
	.hero__title {
		max-width: 14ch;
		font-size: var(--text-3xl);
	}
	.hero__lead {
		max-width: 36rem;
	}
	/* Phones: the original photos come first — the slides carry their own CTAs. */
	@media (width < 48rem) {
		.hero {
			padding-block-start: var(--space-s);
		}
		.hero__inner {
			gap: var(--space-m);
		}
		.hero__aside {
			display: none;
		}
	}
	@media (width >= 75rem) {
		.hero__head {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		}
	}

	/* ---------- Slides -------------------------------------------------- */
	.slide {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-l);
		background: var(--prim-ink);
		color: var(--prim-white);
		text-decoration: none;
		isolation: isolate;
	}
	@media (width >= 48rem) {
		.slide {
			aspect-ratio: 21 / 8;
		}
	}
	.slide :global(.slide__img) {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		z-index: -1;
		transition: scale var(--duration-slower) var(--ease-out);
	}
	.slide:hover :global(.slide__img) {
		scale: 1.03;
	}
	.slide::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(90deg, color-mix(in oklab, var(--prim-ink) 82%, transparent), transparent 70%);
	}
	.slide__body {
		position: absolute;
		inset: auto auto 0 0;
		display: grid;
		gap: var(--space-s);
		justify-items: start;
		max-inline-size: 34rem;
		padding: var(--space-l);
	}
	.slide .slide__tag {
		color: var(--prim-white);
		background: color-mix(in oklab, var(--prim-white) 16%, transparent);
		border-color: color-mix(in oklab, var(--prim-white) 40%, transparent);
		backdrop-filter: blur(var(--space-2xs));
	}
	.slide__title {
		font-size: var(--text-xl);
		font-weight: var(--weight-medium);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
	}
	.slide__cta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		min-block-size: var(--tap-target);
		padding-inline: var(--space-m);
		border-radius: var(--radius-full);
		background: var(--prim-white);
		color: var(--prim-ink);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		transition: gap var(--duration-base) var(--ease-out);
	}
	.slide:hover .slide__cta {
		gap: var(--space-s);
	}
	/* Adobe slide: light canvas (a faint blue tint) so the dark app tiles stand out. */
	.slide--adobe {
		background: linear-gradient(110deg, var(--prim-white) 35%, color-mix(in oklab, var(--brand-logo-blue) 14%, var(--prim-paper-2)));
		color: var(--brand-logo-navy);
	}
	/* Adobe app tiles (Creative Cloud style), gently floating. */
	.slide__apps {
		grid-template-columns: repeat(3, auto);
		place-content: center end;
		gap: var(--space-m);
		padding-inline-end: var(--space-xl);
	}
	.app {
		display: grid;
		justify-items: center;
		gap: var(--space-2xs);
		animation: app-float calc(var(--duration-slower) * 6) var(--ease-in-out) infinite alternate;
		animation-delay: calc(var(--i) * var(--stagger) * -4);
	}
	.app__tile {
		display: grid;
		place-items: center;
		inline-size: clamp(3.5rem, 2rem + 5vw, 6.5rem);
		aspect-ratio: 1;
		border-radius: 22%;
		background: var(--app-bg);
		color: var(--app-fg);
		font-size: var(--text-2xl);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-tight);
		box-shadow: var(--shadow-l);
	}
	.app__name {
		font-size: var(--text-xs);
		opacity: 0.85;
	}
	.app--ps { --app-bg: var(--adobe-ps-bg); --app-fg: var(--adobe-ps-fg); }
	.app--ai { --app-bg: var(--adobe-ai-bg); --app-fg: var(--adobe-ai-fg); }
	.app--id { --app-bg: var(--adobe-id-bg); --app-fg: var(--adobe-id-fg); }
	.app--pr { --app-bg: var(--adobe-pr-bg); --app-fg: var(--adobe-pr-fg); }
	.app--ac { --app-bg: var(--adobe-ac-bg); --app-fg: var(--adobe-ac-fg); }
	.app--br { --app-bg: var(--adobe-br-bg); --app-fg: var(--adobe-br-fg); }
	@keyframes app-float {
		to {
			translate: 0 calc(var(--space-2xs) * -1.5);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.app {
			animation: none;
		}
	}
	.slide--cutout {
		background: linear-gradient(180deg, var(--prim-white), var(--prim-paper-2));
		color: var(--brand-logo-navy);
	}
	.slide--adobe::after,
	.slide--cutout::after {
		display: none;
	}
	.slide__art {
		position: absolute;
		inset: 0 0 0 auto;
		display: grid;
		place-items: center end;
		inline-size: 55%;
