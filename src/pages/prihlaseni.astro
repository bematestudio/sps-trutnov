---
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import SignalField from "../components/SignalField.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Base from "../layouts/Base.astro";
import { cmsUser, loginUrl } from "../lib/auth";
const user = await cmsUser(Astro.session).catch(() => null);
const loggedOut = Astro.url.searchParams.has("odhlaseno");
const portals = [
	{ label: "Studijní průkaz (Bakaláři)", url: "https://bakalari.spstrutnov.cz", icon: "cap" },
	{ label: "Školní e-mail", url: "https://outlook.office.com/mail/", icon: "mail" },
	{ label: "Intranet", url: "http://intranet.spstrutnov.cz", icon: "grid" },
] as const;
---

<Base title="Přihlášení" noindex bare>
	<div class="login">
		<section class="login__art" aria-hidden="true">
			<SignalField />
			<a class="login__brand" href="/" tabindex="-1"><Logo /></a>
			<p class="login__claim">Technika, která tě posune dál.</p>
		</section>
		<section class="login__panel">
			<div class="login__top">
				<a class="link-arrow" href="/"><Icon name="arrow-left" size="s" /> Zpět na web</a>
				<ThemeToggle />
			</div>
			<div class="login__box">
				<div class="stack stack--s">
					<h1 class="h-section">Přihlášení</h1>
					<p class="meta">Administrace webu</p>
					<p class="muted">Pro zaměstnance školy, kteří spravují obsah webu.</p>
				</div>
				{loggedOut && <p class="notice" role="status"><Icon name="check" size="s" /> <span>Byli jste odhlášeni.</span></p>}
				{
					user ? (
						<>
							<p>Přihlášen(a) jako <strong>{user.name || user.email}</strong>.</p>
							<a class="btn btn--block" href="/admin"><span>Pokračovat do administrace</span> <Icon name="arrow" size="s" class="btn__icon btn__icon--arrow" /></a>
							<a class="btn btn--outline btn--block" href="/_emdash/admin">Otevřít EmDash CMS</a>
						</>
					) : (
						<>
							<a class="btn btn--block" href={loginUrl("/admin")}><span>Přihlásit se</span> <Icon name="arrow" size="s" class="btn__icon btn__icon--arrow" /></a>
							<p class="muted">
								Přihlášení probíhá v redakčním systému EmDash (passkey nebo odkaz e-mailem). Účet vám založí správce webu v{" "}
								<a class="link" href="/_emdash/admin">EmDash CMS</a> → Uživatelé.
							</p>
						</>
					)
				}
			</div>
			<nav class="login__portals" aria-label="Školní portály">
				<p class="meta">Hledáte něco jiného?</p>
				<ul role="list">
					{portals.map((p) => (
						<li><a href={p.url} target="_blank" rel="noopener"><Icon name={p.icon} size="s" /> {p.label} <Icon name="arrow-up-right" size="s" /></a></li>
					))}
				</ul>
			</nav>
		</section>
	</div>
</Base>

<style>
	.login {
		display: grid;
		min-block-size: 100dvh;
	}
	.login__art {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: none;
		padding: var(--space-xl);
		background: var(--prim-ink);
		color: var(--prim-paper);
		--color-text: var(--prim-paper);
		--color-text-muted: var(--prim-slate-light);
		--color-hero-line: color-mix(in oklab, var(--prim-paper) 26%, transparent);
		--color-hero-line-accent: var(--prim-blue-500);
	}
	.login__art :global(.signal) {
		z-index: -1;
	}
	.login__brand {
		text-decoration: none;
	}
	.login__claim {
		position: absolute;
		inset-inline: var(--space-xl);
		inset-block-end: var(--space-xl);
		font-size: var(--text-2xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		font-weight: var(--weight-medium);
		max-width: 14ch;
	}
	.login__panel {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: var(--space-xl);
		padding: var(--space-m) var(--gutter) var(--space-xl);
	}
	.login__top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.login__box {
		display: grid;
		gap: var(--space-m);
		align-content: center;
		inline-size: min(100%, 28rem);
		margin-inline: auto;
	}
	.login__portals {
		inline-size: min(100%, 28rem);
		margin-inline: auto;
		display: grid;
		gap: var(--space-xs);
	}
	.login__portals ul {
		display: grid;
	}
	.login__portals a {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		min-block-size: var(--tap-target);
		text-decoration: none;
		border-bottom: var(--border-width) solid var(--color-border);
		transition: color var(--duration-fast) var(--ease-out);
	}
	.login__portals a :global(svg:last-child) {
		margin-inline-start: auto;
	}
	.login__portals a:hover {
		color: var(--color-accent-text);
	}
	@media (width >= 75rem) {
		.login {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
		.login__art {
			display: block;
		}
	}
</style>


