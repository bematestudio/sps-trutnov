{
  "name": "sps-trutnov-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web St\u0159edn\u00ed pr\u016fmyslov\u00e9 \u0161koly Trutnov \u2014 Astro + EmDash CMS na Cloudflare Workers",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "test:e2e": "playwright test",
    "critique": "node scripts/critique.mjs",
    "optimize:media": "node scripts/optimize-media.mjs",
    "migrate:cms": "node -e \"fetch(process.env.SITE_URL+'/api/maintenance/migrate',{method:'POST',headers:{authorization:'Bearer '+process.env.MAINTENANCE_TOKEN}}).then(r=>r.text()).then(console.log)\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.4",
    "@astrojs/react": "7.1.2",
    "@emdash-cms/cloudflare": "1.4.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "7.4.5",
    "emdash": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unstorage": "1.17.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@playwright/test": "1.64.1",
    "impeccable": "4.8.0",
    "sharp": "0.35.5",
    "typescript": "^5.9.3",
    "wrangler": "4.157.0"
  }
}
