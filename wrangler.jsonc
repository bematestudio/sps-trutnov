{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sps-trutnov",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Run the Worker next to the CMS database (one Durable Object) instead of next
	// to the visitor: a page makes ~10 sequential DB queries, so this turns
	// 10 long round trips into one.
	"placement": { "mode": "smart" },
	"workers_dev": true,
	"preview_urls": true,
	// EmDash CMS database: one SQLite-backed Durable Object
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_DB", "class_name": "EmDashDB" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["EmDashDB"] }],
	// Both buckets are in the EU jurisdiction (data stays in the EU).
	"r2_buckets": [
		{ "binding": "MEDIA", "bucket_name": "sps-trutnov-media-eu", "jurisdiction": "eu" },
		{ "binding": "SESSIONS", "bucket_name": "sps-trutnov-sessions-eu", "jurisdiction": "eu" }
	],
	// Scheduled publishing + maintenance for EmDash
	"triggers": {
		"crons": ["*/5 * * * *"]
	}
}
